{
  "extraKnownMarketplaces": {
    "zeroxsolutions": {
      "source": {
        "source": "github",
        "repo": "zeroxsolutions/agent-plugins"
      }
    }
  },
  "enabledPlugins": {
    "superpowers@claude-plugins-official": true,
    "ts-js-best-practices@zeroxsolutions": true
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/block-manual-project.mjs\""
          },
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/block-secrets-in-vars.mjs\""
          }
        ]
      },
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/block-secrets-in-vars.mjs\""
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/block-git-no-verify.mjs\""
          },
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/block-app-without-e2e.mjs\""
          },
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/remind-rule-audit.mjs\""
          }
        ]
      }
    ]
  }
}
