# pnpm rewrites it on every install, so formatting is undone by the next `pnpm add`.
/pnpm-lock.yaml

# nx and pnpm both write these too: a version field on release, a dependency on `pnpm add`. A
# formatted copy drifts from what the next tool run writes, which is the reason above. Prettier
# also explodes every compact nx target inside a package.json - `"dependsOn": ["^build"]` over
# three lines - for the length of the file.
package.json
/pnpm-workspace.yaml

# The Claude settings are stamped from nx-scaffold, so a formatted copy diffs against the stamp
# until the next one reverts it.
/.claude

# Terraform's provider cache: vendored and credential-bearing. Unanchored on purpose -
# `terraform init` inside a module writes one there too.
**/.terraform

# Mirrors .gitignore, because prettier does not read it.
dist
out
out-tsc
tmp
.next
.open-next
.wrangler
test-output
.playwright-mcp

# Upstream's, vendored by the shadcn CLI: a file the formatter rewrote can no longer be told
# from an upstream change by `shadcn diff`. `ui` is a directory the CLI owns; the other two it
# placed by kind rather than by directory, into buckets that also hold each app's own files, so
# those are named file by file. Globbed over `apps/*` because the set is the same in every app
# carrying a components.json, and a new one arrives already covered.
apps/*/src/components/ui
apps/*/src/hooks/use-mobile.ts
apps/*/src/lib/utils.ts
# The registry app keeps the same three under its components.json aliases instead.
apps/registry-ui/registry/bases/base-ui/ui
apps/registry-ui/registry/bases/base-ui/hooks/use-mobile.ts
apps/registry-ui/registry/bases/base-ui/lib/utils.ts

# Each carries its own "do not edit" header; `wrangler types` and Next rewrite them per build.
**/worker-configuration.d.ts
**/cloudflare-env.d.ts
**/next-env.d.ts

# Loaded into every agent session, and prettier pads markdown table columns - measured once at
