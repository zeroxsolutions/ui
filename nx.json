{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "defaultBase": "origin/master",
  "pluginsConfig": {
    "@nx/js": {
      "projectsAffectedByDependencyUpdates": "auto"
    }
  },
  "analytics": false,
  "namedInputs": {
    "default": ["{projectRoot}/**/*", "sharedGlobals"],
    "production": [
      "default",
      "!{projectRoot}/**/?(*.)+(spec|test).[jt]s?(x)?(.snap)",
      "!{projectRoot}/tsconfig.spec.json",
      "!{projectRoot}/src/test-setup.[jt]s",
      "!{projectRoot}/.oxlintrc.jsonc",
      "!{projectRoot}/jest.config.?([cm])[jt]s",
      "!{projectRoot}/test-setup.[jt]s"
    ],
    "sharedGlobals": []
  },
  "tui": {
    "enabled": false
  },
  "plugins": [
    {
      "plugin": "@nx/js/typescript",
      "options": {
        "typecheck": {
          "targetName": "typecheck"
        },
        "build": {
          "targetName": "build",
          "configName": "tsconfig.lib.json",
          "buildDepsName": "build-deps",
          "watchDepsName": "watch-deps"
        }
      }
    },
    {
      "plugin": "@nx/vite/plugin",
      "options": {
        "buildTargetName": "build",
        "serveTargetName": "serve",
        "devTargetName": "dev",
        "previewTargetName": "preview",
        "serveStaticTargetName": "serve-static",
        "typecheckTargetName": "typecheck",
        "buildDepsTargetName": "build-deps",
        "watchDepsTargetName": "watch-deps"
      }
    },
    {
      "plugin": "@nx/vitest",
      "options": {
        "testTargetName": "test"
      }
    },
    {
      "plugin": "@nx/next/plugin",
      "options": {
        "startTargetName": "start",
        "buildTargetName": "build",
        "devTargetName": "dev",
        "serveStaticTargetName": "serve-static",
        "buildDepsTargetName": "build-deps",
        "watchDepsTargetName": "watch-deps"
      }
    },
    {
      "plugin": "@nx/oxlint",
      "options": {
        "targetName": "lint"
      }
    },
    {
      "plugin": "@nx/playwright/plugin",
      "options": {
        "targetName": "e2e"
      }
    },
    {
      "plugin": "@nx/expo/plugin",
      "options": {
        "startTargetName": "start",
        "buildTargetName": "build",
        "prebuildTargetName": "prebuild",
        "serveTargetName": "serve",
        "installTargetName": "install",
        "exportTargetName": "export",
        "submitTargetName": "submit",
        "runIosTargetName": "run-ios",
        "runAndroidTargetName": "run-android",
        "buildDepsTargetName": "build-deps",
        "watchDepsTargetName": "watch-deps"
      }
    },
    {
      "plugin": "@nx/jest/plugin",
      "options": {
        "targetName": "test"
      }
    }
  ],
  "targetDefaults": {
    "lint": {
      "dependsOn": ["lint-deps"]
    },
    "lint-deps": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "{projectRoot}/package.json",
        "{projectRoot}/src/**/*",
        "{workspaceRoot}/knip.jsonc",
        {
          "externalDependencies": ["knip"]
        }
      ],
      "options": {
        "commands": [
          "knip --workspace {projectRoot} --production --include dependencies,unlisted,unresolved --no-config-hints",
          "knip --workspace {projectRoot} --strict --include unlisted --no-config-hints"
        ],
        "parallel": false
      }
    },
    "test": {
      "dependsOn": ["^build"]
    }
  },
  "release": {
    "projects": ["packages/*"],
    "projectsRelationship": "independent",
    "version": {
      "fallbackCurrentVersionResolver": "disk",
      "conventionalCommits": true,
      "preVersionCommand": "git clean -xdfq packages/*/dist && pnpm nx run-many -t build --exclude=tag:build:remote --skip-nx-cache",
      "git": {
        "commit": true,
        "tag": true
      }
    },
    "changelog": {
      "workspaceChangelog": false,
      "projectChangelogs": true,
      "git": {
        "commit": true,
        "tag": true
      }
    },
    "conventionalCommits": {
      "types": {
        "refactor": {
          "changelog": {
            "hidden": false
          }
        }
      }
    }
  },
  "generators": {
    "@nx/react": {
      "library": {
        "style": "css",
        "linter": "none",
        "unitTestRunner": "vitest"
      },
      "application": {
        "babel": true,
        "style": "css",
        "linter": "none",
        "bundler": "vite"
      },
      "component": {
        "style": "css"
      }
    },
    "@nx/next": {
      "application": {
        "style": "css",
        "linter": "oxlint"
      }
    }
  },
  "affected": {
    "legacy": true
  }
}
