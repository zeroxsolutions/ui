# See https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files for more about ignoring files.

# compiled output
dist
tmp
out-tsc

# dependencies
node_modules

# IDEs and editors
/.idea
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# IDE - VSCode
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# misc
/.sass-cache
/connect.lock
/coverage
/libpeerconnection.log
npm-debug.log
yarn-error.log
testem.log
/typings

# System Files
.DS_Store
Thumbs.db

.nx/cache
.nx/workspace-data
.nx/migrate-runs
.claude/worktrees
.claude/settings.local.json

# Next.js
.next

# OpenNext (Cloudflare adapter build output)
.open-next/

# Wrangler local state / cache
.wrangler/

out
test-output
vite.config.*.timestamp*

# Local secrets: nx loads the root .env into every task, which is how `rclone:sync` reads its keys
# locally. Commit only *.example.
.env
.env.*
!.env.example

# Local wrangler dev secrets (.dev.vars mirrors prod secrets for `wrangler dev`) - never commit.
.dev.vars*
!.dev.vars.example

# Playwright MCP (browser automation) runtime output - console logs + screenshots
.playwright-mcp/

.nx/polygraph
.nx/self-healing
vitest.config.*.timestamp*
storybook-static

# fumadocs-mdx generated source (regenerated by the postinstall / build)
.source

# Generated shadcn registry JSON (emitted by @zeroxsolutions/registry-ui:shadcn-build)
apps/registry-ui/public/r

# Playwright e2e artifacts (regenerated screenshots + reports)
apps/registry-ui-e2e/screenshots
playwright-report
test-results
