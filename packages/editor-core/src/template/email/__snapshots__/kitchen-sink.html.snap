<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="color-scheme" content="light dark"><meta name="supported-color-schemes" content="light dark"><title>Kitchen sink</title><style>@media only screen and (max-width:600px){.zx-outer{padding:0 !important;}.zx-card{border:0 !important;border-radius:0 !important;}.zx-inner{padding:24px 20px !important;}.zx-text{font-size:16px !important;line-height:24px !important;}.zx-region-footer .zx-text{font-size:12px !important;line-height:17px !important;}.zx-footer-line{font-size:12px !important;line-height:17px !important;}.zx-button{display:block !important;text-align:center !important;font-size:16px !important;line-height:22px !important;padding:12px 16px !important;}.zx-lane{display:block !important;width:100% !important;padding:0 !important;}.zx-caption{font-size:12px !important;line-height:17px !important;}.zx-legal-text{font-size:12px !important;line-height:17px !important;}}@media (prefers-color-scheme:dark){.zx-body{background:#0A0A0A !important;}.zx-canvas{background:#0A0A0A !important;}.zx-card{background:#0A0A0A !important;border-color:#262626 !important;}.zx-text{color:#FAFAFA !important;}.zx-heading{color:#FAFAFA !important;}.zx-tone-muted{color:#A1A1A1 !important;}.zx-region-footer .zx-text{color:#A1A1A1 !important;}.zx-footer-line{color:#A1A1A1 !important;}.zx-link{color:#00BC7D !important;}.zx-callout{background:#262626 !important;border-color:#262626 !important;}.zx-code{color:#FAFAFA !important;background:#262626 !important;}.zx-button{background:#00BC7D !important;color:#022C22 !important;}.zx-divider{border-color:#262626 !important;}.zx-quote{border-color:#262626 !important;}.zx-table-cell{color:#FAFAFA !important;border-color:#262626 !important;}.zx-table-head{background:#262626 !important;}.zx-card-block{border-color:#262626 !important;}.zx-footer{border-color:#262626 !important;}}</style></head><body class="zx-body" style="margin:0;padding:0;background:#FFFFFF;"><div class="zx-preheader" style="display:none;max-height:0;overflow:hidden;mso-hide:all;">Every block</div><table role="presentation" cellpadding="0" cellspacing="0" width="100%" class="zx-canvas" style="background:#FFFFFF;"><tr><td align="center" class="zx-outer" style="padding:24px 12px;"><!--[if mso]><table role="presentation" width="600" align="center" cellpadding="0" cellspacing="0"><tr><td><![endif]--><table role="presentation" cellpadding="0" cellspacing="0" class="zx-card" style="width:100%;max-width:600px;background:#FFFFFF;border:1px solid #E4E4E7;border-radius:10px;"><tr><td class="zx-inner" style="padding:16px;"><table role="presentation" cellpadding="0" cellspacing="0" width="100%"><tr><td class="zx-logo" style="padding:0 0 10px;"><img src="https://cdn.x.test/logo@2x.png" alt="Example" width="120" class="zx-image" style="display:block;border:0;height:auto;" /></td></tr><tr><td><table role="presentation" cellpadding="0" cellspacing="0" width="100%" class="zx-region zx-region-header"><tr><td class="zx-block zx-block-paragraph zx-align-left zx-space-medium" style="text-align:left;padding:0 0 10px;"><div class="zx-text zx-tone-default" style="font-family:Inter, Arial, Helvetica, sans-serif;font-size:14px;line-height:20px;color:#09090B;">Region line</div></td></tr><tr><td class="zx-block zx-block-columns zx-align-left zx-space-medium" style="text-align:left;padding:0 0 10px;"><table role="presentation" cellpadding="0" cellspacing="0" width="100%" class="zx-columns"><tr><td width="50%" valign="top" class="zx-lane" style="padding:0 8px 0 0;"><table role="presentation" cellpadding="0" cellspacing="0" width="100%"><tr><td class="zx-block zx-block-paragraph zx-align-left zx-space-medium" style="text-align:left;padding:0 0 10px;"><div class="zx-text zx-tone-default" style="font-family:Inter, Arial, Helvetica, sans-serif;font-size:14px;line-height:20px;color:#09090B;">L</div></td></tr></table></td><td width="50%" valign="top" class="zx-lane zx-lane-last" style="padding:0;"><table role="presentation" cellpadding="0" cellspacing="0" width="100%"><tr><td class="zx-block zx-block-paragraph zx-align-left zx-space-medium" style="text-align:left;padding:0 0 10px;"><div class="zx-text zx-tone-default" style="font-family:Inter, Arial, Helvetica, sans-serif;font-size:14px;line-height:20px;color:#09090B;">R</div></td></tr></table></td></tr></table></td></tr></table></td></tr><tr><td><table role="presentation" cellpadding="0" cellspacing="0" width="100%" class="zx-region zx-region-body"><tr><td class="zx-block zx-block-paragraph zx-align-left zx-space-medium" style="text-align:left;padding:0 0 10px;"><div class="zx-text zx-tone-default" style="font-family:Inter, Arial, Helvetica, sans-serif;font-size:14px;line-height:20px;color:#09090B;">Hi Lan, <strong>bold</strong> <em>italic</em> and <a href="https://example.com/a" class="zx-link" style="color:#007A55;">a link</a>.</div></td></tr><tr><td class="zx-block zx-block-paragraph zx-align-center zx-space-large" style="text-align:center;padding:0 0 20px;"><div class="zx-text zx-tone-muted" style="font-family:Inter, Arial, Helvetica, sans-serif;font-size:14px;line-height:20px;color:#63636D;">Muted, centred, large gap.</div></td></tr><tr><td class="zx-block zx-block-paragraph zx-align-right zx-space-small" style="text-align:right;padding:0 0 6px;"><div class="zx-text zx-tone-default" style="font-family:Inter, Arial, Helvetica, sans-serif;font-size:14px;line-height:20px;color:#09090B;">Right, small gap.</div></td></tr><tr><td class="zx-block zx-block-heading zx-align-center zx-space-medium" style="text-align:center;padding:0 0 10px;"><h1 class="zx-heading zx-heading-1" style="margin:0;font-family:Inter, Arial, Helvetica, sans-serif;font-weight:600;color:#09090B;font-size:24px;line-height:32px;">Heading <strong>one</strong></h1></td></tr><tr><td class="zx-block zx-block-quote zx-align-left zx-space-medium" style="text-align:left;padding:0 0 10px;"><table role="presentation" cellpadding="0" cellspacing="0" width="100%"><tr><td class="zx-quote" style="border-left:3px solid #E4E4E7;padding:0 0 0 12px;"><div class="zx-text zx-tone-muted" style="font-family:Inter, Arial, Helvetica, sans-serif;font-size:14px;line-height:20px;color:#63636D;">A quote from Lan</div></td></tr></table></td></tr><tr><td class="zx-block zx-block-button zx-align-left zx-space-medium" style="text-align:left;padding:0 0 10px;"><a href="https://example.com/a" class="zx-button zx-width-inline" style="display:inline-block;background:#007A55;color:#ECFDF5;font-family:Inter, Arial, Helvetica, sans-serif;font-size:14px;font-weight:500;line-height:18px;padding:7px 10px;border-radius:10px;text-decoration:none;">Inline button</a></td></tr><tr><td class="zx-block zx-block-button zx-align-left zx-space-medium" style="text-align:left;padding:0 0 10px;"><a href="https://example.com/a" class="zx-button zx-width-full" style="background:#007A55;color:#ECFDF5;font-family:Inter, Arial, Helvetica, sans-serif;font-size:14px;font-weight:500;line-height:18px;padding:7px 10px;border-radius:10px;text-decoration:none;display:block;text-align:center;">Full button</a></td></tr><tr><td class="zx-block zx-block-code zx-align-center zx-space-medium" style="text-align:center;padding:0 0 10px;"><div class="zx-code" style="display:inline-block;font-family:ui-monospace, SFMono-Regular, Menlo, Consolas, &#39;Courier New&#39;, monospace;font-size:24px;font-weight:600;letter-spacing:4px;line-height:32px;white-space:pre-wrap;color:#09090B;background:#F4F4F5;border-radius:10px;padding:12px 16px;">482 913</div></td></tr><tr><td class="zx-block zx-block-list zx-align-left zx-space-medium" style="text-align:left;padding:0 0 10px;"><ul class="zx-text zx-list" style="font-family:Inter, Arial, Helvetica, sans-serif;font-size:14px;line-height:20px;color:#09090B;margin:0;padding-left:20px;"><li>One <strong>bold</strong></li><li>Two <a href="https://example.com/a" class="zx-link" style="color:#007A55;">link</a></li></ul></td></tr><tr><td class="zx-block zx-block-callout zx-align-center zx-space-medium" style="text-align:center;padding:0 0 10px;"><table role="presentation" cellpadding="0" cellspacing="0" width="100%"><tr><td class="zx-callout" style="background:#F4F4F5;border:1px solid #E4E4E7;border-radius:10px;padding:12px 16px;"><div class="zx-text" style="font-family:Inter, Arial, Helvetica, sans-serif;font-size:14px;line-height:20px;color:#09090B;">A callout with <strong>marks</strong>.</div></td></tr></table></td></tr><tr><td class="zx-block zx-block-divider zx-align-left zx-space-large" style="text-align:left;padding:0 0 20px;"><div class="zx-divider" style="border-top:1px solid #E4E4E7;font-size:0;line-height:0;">&nbsp;</div></td></tr><tr><td class="zx-block zx-block-image zx-align-center zx-space-medium" style="text-align:center;padding:0 0 10px;"><img src="https://x.test/a.png" alt="A bay" width="300" class="zx-image zx-image-fluid" style="display:block;border:0;height:auto;max-width:100%;margin:0 auto;" /></td></tr><tr><td class="zx-block zx-block-image zx-align-left zx-space-medium" style="text-align:left;padding:0 0 10px;"><img src="https://x.test/a.png" alt="A bay" width="566" class="zx-image zx-image-fluid" style="display:block;border:0;height:auto;max-width:100%;" /></td></tr><tr><td class="zx-block zx-block-table zx-align-left zx-space-medium" style="text-align:left;padding:0 0 10px;"><table cellpadding="0" cellspacing="0" border="0" width="100%" class="zx-table" style="border-collapse:collapse;"><tr><th scope="col" align="left" valign="top" class="zx-table-cell zx-table-head" style="border:1px solid #E4E4E7;padding:6px 8px;font-family:Inter, Arial, Helvetica, sans-serif;font-size:14px;line-height:20px;color:#09090B;text-align:left;vertical-align:top;font-weight:600;background:#F4F4F5;">Day</th><th scope="col" align="left" valign="top" class="zx-table-cell zx-table-head" style="border:1px solid #E4E4E7;padding:6px 8px;font-family:Inter, Arial, Helvetica, sans-serif;font-size:14px;line-height:20px;color:#09090B;text-align:left;vertical-align:top;font-weight:600;background:#F4F4F5;">Place</th></tr><tr><td align="left" valign="top" class="zx-table-cell" style="border:1px solid #E4E4E7;padding:6px 8px;font-family:Inter, Arial, Helvetica, sans-serif;font-size:14px;line-height:20px;color:#09090B;text-align:left;vertical-align:top;">1</td><td align="left" valign="top" class="zx-table-cell" style="border:1px solid #E4E4E7;padding:6px 8px;font-family:Inter, Arial, Helvetica, sans-serif;font-size:14px;line-height:20px;color:#09090B;text-align:left;vertical-align:top;">Lan</td></tr></table></td></tr><tr><td class="zx-block zx-block-columns zx-align-left zx-space-medium" style="text-align:left;padding:0 0 10px;"><table role="presentation" cellpadding="0" cellspacing="0" width="100%" class="zx-columns"><tr><td width="50%" valign="top" class="zx-lane" style="padding:0 8px 0 0;"><table role="presentation" cellpadding="0" cellspacing="0" width="100%"><tr><td class="zx-block zx-block-paragraph zx-align-left zx-space-medium" style="text-align:left;padding:0 0 10px;"><div class="zx-text zx-tone-default" style="font-family:Inter, Arial, Helvetica, sans-serif;font-size:14px;line-height:20px;color:#09090B;">Left lane</div></td></tr><tr><td class="zx-block zx-block-image zx-align-left zx-space-medium" style="text-align:left;padding:0 0 10px;"><img src="https://x.test/a.png" alt="A bay" width="275" class="zx-image zx-image-fluid" style="display:block;border:0;height:auto;max-width:100%;" /></td></tr></table></td><td width="25%" valign="top" class="zx-lane" style="padding:0 8px 0 0;"><table role="presentation" cellpadding="0" cellspacing="0" width="100%"><tr><td class="zx-block zx-block-paragraph zx-align-left zx-space-medium" style="text-align:left;padding:0 0 10px;"><div class="zx-text zx-tone-default" style="font-family:Inter, Arial, Helvetica, sans-serif;font-size:14px;line-height:20px;color:#09090B;">Middle</div></td></tr></table></td><td width="25%" valign="top" class="zx-lane zx-lane-last" style="padding:0;"><table role="presentation" cellpadding="0" cellspacing="0" width="100%"><tr><td class="zx-block zx-block-paragraph zx-align-left zx-space-medium" style="text-align:left;padding:0 0 10px;"><div class="zx-text zx-tone-default" style="font-family:Inter, Arial, Helvetica, sans-serif;font-size:14px;line-height:20px;color:#09090B;">Right</div></td></tr></table></td></tr></table></td></tr><tr><td class="zx-block zx-block-html zx-align-left zx-space-medium" style="text-align:left;padding:0 0 10px;"><p style="margin:0">Raw <b>html</b></p></td></tr></table></td></tr><tr><td class="zx-footer" style="padding:10px 0 0;border-top:1px solid #E4E4E7;"><table role="presentation" cellpadding="0" cellspacing="0" width="100%" class="zx-region zx-region-footer"><tr><td class="zx-block zx-block-paragraph zx-align-left zx-space-medium" style="text-align:left;padding:0 0 10px;"><div class="zx-text zx-tone-default" style="font-family:Inter, Arial, Helvetica, sans-serif;font-size:12px;line-height:17px;color:#63636D;">Region line</div></td></tr><tr><td class="zx-block zx-block-columns zx-align-left zx-space-medium" style="text-align:left;padding:0 0 10px;"><table role="presentation" cellpadding="0" cellspacing="0" width="100%" class="zx-columns"><tr><td width="50%" valign="top" class="zx-lane" style="padding:0 8px 0 0;"><table role="presentation" cellpadding="0" cellspacing="0" width="100%"><tr><td class="zx-block zx-block-paragraph zx-align-left zx-space-medium" style="text-align:left;padding:0 0 10px;"><div class="zx-text zx-tone-default" style="font-family:Inter, Arial, Helvetica, sans-serif;font-size:12px;line-height:17px;color:#63636D;">L</div></td></tr></table></td><td width="50%" valign="top" class="zx-lane zx-lane-last" style="padding:0;"><table role="presentation" cellpadding="0" cellspacing="0" width="100%"><tr><td class="zx-block zx-block-paragraph zx-align-left zx-space-medium" style="text-align:left;padding:0 0 10px;"><div class="zx-text zx-tone-default" style="font-family:Inter, Arial, Helvetica, sans-serif;font-size:12px;line-height:17px;color:#63636D;">R</div></td></tr></table></td></tr></table></td></tr></table><div class="zx-text zx-footer-line" style="font-family:Inter, Arial, Helvetica, sans-serif;margin:0 0 4px;font-size:12px;line-height:17px;color:#63636D;">Example Company Limited, 1 Example Street.</div><div class="zx-text zx-footer-line" style="font-family:Inter, Arial, Helvetica, sans-serif;margin:0 0 4px;font-size:12px;line-height:17px;color:#63636D;">Sent because you created an account.</div></td></tr></table></td></tr></table><!--[if mso]></td></tr></table><![endif]--></td></tr></table></body></html>