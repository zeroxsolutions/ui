{
  "name": "@zeroxsolutions/icons",
  "version": "0.1.1",
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./package.json": "./package.json",
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js"
    },
    "./lib/*": null
  },
  "files": [
    "dist",
    "!**/*.tsbuildinfo"
  ],
  "peerDependencies": {
    "@types/react": "^19.0.0",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "peerDependenciesMeta": {
    "@types/react": {
      "optional": true
    }
  },
  "devDependencies": {
    "glob": "^13.0.6"
  },
  "nx": {
    "targets": {
      "lint-deps": {},
      "brand-manifest": {
        "executor": "nx:run-commands",
        "outputs": ["{projectRoot}/src/lib/brand-manifest.ts"],
        "options": {
          "cwd": "{projectRoot}",
          "command": "node tools/build-brand-manifest.mts"
        }
      },
      "rclone:sync": {
        "executor": "nx:run-commands",
        "options": {
          "cwd": "{projectRoot}",
          "command": "./tools/rclone-sync.sh"
        }
      }
    }
  }
}
