    "react-native-svg": "^15.16.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@babel/runtime": "~7.27.6",
    "@expo/cli": "58.1.13",
    "@expo/dom-webview": "58.0.2",
    "@expo/metro-runtime": "58.0.14",
    "@expo/vector-icons": "15.1.1",
    "@react-native/jest-preset": "0.88.0",
    "@testing-library/react-native": "14.1.0",
    "@types/jest": "~30.0.0",
    "babel-jest": "~30.3.0",
    "babel-preset-expo": "58.0.18",
    "expo": "58.0.16",
    "jest": "~30.3.0",
    "jest-environment-jsdom": "~30.3.0",
    "jest-expo": "58.0.11",
    "jest-util": "~30.3.0",
    "nativewind": "4.2.7",
    "react": "catalog:",
