{
  "name": "@zeroxsolutions/registry-native",
  "version": "0.0.1",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@rn-primitives/avatar": "1.5.2",
    "@rn-primitives/checkbox": "1.5.2",
    "@rn-primitives/label": "1.5.2",
    "@rn-primitives/progress": "1.5.2",
    "@rn-primitives/radio-group": "1.5.2",
    "@rn-primitives/separator": "1.5.2",
    "@rn-primitives/slot": "1.5.2",
    "@rn-primitives/switch": "1.5.2",
    "class-variance-authority": "catalog:",
    "clsx": "^2.1.1",
    "lucide-react-native": "1.60.0",
    "react-native-svg": "^15.16.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@babel/runtime": "~7.27.6",
    "@expo-google-fonts/geist": "0.4.2",
    "@expo/cli": "58.1.13",
    "@expo/dom-webview": "58.0.2",
    "@expo/metro-runtime": "58.0.14",
    "@expo/vector-icons": "15.1.1",
    "@react-native/jest-preset": "0.88.0",
    "@testing-library/react-native": "14.1.0",
    "@types/jest": "~30.0.0",
    "babel-jest": "~30.3.0",
    "babel-preset-expo": "58.0.18",
    "expo": "58.0.16",
    "expo-font": "58.0.9",
    "jest": "~30.3.0",
    "jest-environment-jsdom": "~30.3.0",
    "jest-expo": "58.0.11",
    "jest-util": "~30.3.0",
    "nativewind": "4.2.7",
    "react": "catalog:",
    "react-native": "0.88.0",
    "react-native-css-interop": "0.2.7",
    "react-test-renderer": "catalog:",
    "shadcn": "catalog:",
    "ts-jest": "^29.4.7",
    "uniwind": "1.13.0"
  },
  "nx": {
    "targets": {
      "build-registry": {
        "executor": "nx:run-commands",
        "cache": true,
        "inputs": [
          "{projectRoot}/registry.json",
          "{projectRoot}/styles/**/*",
          "{projectRoot}/tools/build-registry.mts",
          "{projectRoot}/src/build/**/*",
          "{projectRoot}/src/registry/**/*",
          "!{projectRoot}/src/**/*.spec.[jt]s?(x)",
          { "externalDependencies": ["shadcn"] }
        ],
        "outputs": ["{projectRoot}/dist/r"],
        "options": {
          "cwd": "{projectRoot}",
          "command": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON tools/build-registry.mts"
        }
      },
      "test": {
        "dependsOn": ["^build", "build-registry"]
      },
      "sync-upstream-styles": {
        "executor": "nx:run-commands",
        "cache": false,
        "options": {
          "cwd": "{projectRoot}",
          "command": "node tools/sync-upstream-styles.mts {args.commit}"
        }
      }
    }
  }
}
