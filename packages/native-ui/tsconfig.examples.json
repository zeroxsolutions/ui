{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "out-tsc/examples",
    "types": ["node"],
    "jsx": "react-jsx",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["es2023", "dom"],
    // The demos and the preview import the items as an app does; build-registry writes NativeWind's Vega
    // sources there. The preview imports each style's demos through `@styles/<style>/`.
    "paths": { "@/*": ["./dist/src/nativewind-vega/*"], "@styles/*": ["./dist/src/nativewind-*"] },
    "tsBuildInfoFile": "out-tsc/examples/tsconfig.examples.tsbuildinfo"
  },
  "files": ["src/nativewind-env.d.ts"],
  "include": [
    "src/examples/**/*.ts",
    "src/examples/**/*.tsx",
    "src/preview/**/*.ts",
    "src/preview/**/*.tsx",
    "dist/src/nativewind-nova/examples/**/*.ts",
    "dist/src/nativewind-nova/examples/**/*.tsx",
    // The preview draws each style's Toaster, whose queue only that style's demos raise toasts into.
    "dist/src/nativewind-nova/components/ui/sonner.tsx",
    "dist/src/nativewind-vega/**/*.ts",
    "dist/src/nativewind-vega/**/*.tsx"
  ],
  "exclude": [
    "src/examples/**/*.spec.ts",
    "src/examples/**/*.spec.tsx",
    "src/preview/**/*.spec.ts",
    "src/preview/**/*.spec.tsx"
  ]
}
