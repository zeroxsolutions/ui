{
  "name": "@zeroxsolutions/native-ui",
  "version": "0.0.1",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./examples": {
      "types": "./src/examples/index.ts",
      "import": "./src/examples/index.ts",
      "default": "./src/examples/index.ts"
    },
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@rn-primitives/avatar": "catalog:rn-primitives",
    "@rn-primitives/checkbox": "catalog:rn-primitives",
    "@rn-primitives/label": "catalog:rn-primitives",
    "@rn-primitives/progress": "catalog:rn-primitives",
    "@rn-primitives/radio-group": "catalog:rn-primitives",
    "@rn-primitives/separator": "catalog:rn-primitives",
    "@rn-primitives/slot": "catalog:rn-primitives",
    "@rn-primitives/switch": "catalog:rn-primitives",
    "@rn-primitives/tabs": "catalog:rn-primitives",
    "@rn-primitives/toggle": "catalog:rn-primitives",
    "@rn-primitives/toggle-group": "catalog:rn-primitives",
    "class-variance-authority": "catalog:",
    "clsx": "catalog:",
    "lucide-react-native": "catalog:",
    "react-native-svg": "catalog:expo",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@babel/runtime": "~7.27.6",
    "@expo-google-fonts/geist": "catalog:",
    "@expo/cli": "58.1.13",
    "@expo/dom-webview": "58.0.2",
    "@expo/metro-runtime": "catalog:expo",
    "@expo/vector-icons": "15.1.1",
    "@react-native/jest-preset": "0.88.0",
    "@testing-library/react-native": "catalog:",
    "@types/jest": "catalog:",
    "babel-jest": "catalog:",
    "babel-preset-expo": "catalog:expo",
    "expo": "catalog:expo",
    "expo-font": "catalog:expo",
    "jest": "catalog:",
    "jest-environment-jsdom": "~30.5.2",
    "jest-expo": "catalog:expo",
    "jest-util": "~30.5.1",
    "nativewind": "4.2.7",
    "react": "catalog:",
    "react-native": "catalog:expo",
    "react-native-css-interop": "catalog:",
    "react-test-renderer": "catalog:",
    "shadcn": "catalog:",
    "ts-jest": "^29.4.7",
    "uniwind": "1.13.0"
  },
  "nx": {
    "targets": {
      "build-registry": {
        "executor": "nx:run-commands",
        "cache": true,
        "inputs": [
          "{projectRoot}/registry.json",
          "{projectRoot}/styles/**/*",
          "{projectRoot}/tools/build-registry.mts",
          "{projectRoot}/src/build/**/*",
          "{projectRoot}/src/registry/**/*",
          "!{projectRoot}/src/**/*.spec.[jt]s?(x)",
          {
            "externalDependencies": [
              "shadcn"
            ]
          }
        ],
        "outputs": [
          "{projectRoot}/dist/r",
          "{projectRoot}/dist/src"
        ],
        "options": {
          "cwd": "{projectRoot}",
          "command": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON tools/build-registry.mts"
        }
      },
      "test": {
        "dependsOn": [
          "^build",
          "build-registry"
        ]
      },
      "typecheck": {
        "dependsOn": [
          "^typecheck",
          "build-registry"
        ]
      },
      "sync-upstream-styles": {
        "executor": "nx:run-commands",
        "cache": false,
        "options": {
          "cwd": "{projectRoot}",
          "command": "node tools/sync-upstream-styles.mts {args.commit}"
        }
      }
    },
    "name": "@zeroxsolutions/native-ui"
  }
}
