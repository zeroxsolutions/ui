{
  "name": "@zeroxsolutions/fluent-emoji",
  "version": "0.1.2",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./catalog": {
      "types": "./dist/catalog.d.ts",
      "import": "./dist/catalog.js",
      "default": "./dist/catalog.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "NOTICE",
    "!dist/assets/anim",
    "!**/*.tsbuildinfo"
  ],
  "peerDependencies": {
    "@types/react": "^19.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "@types/react": {
      "optional": true
    }
  },
  "nx": {
    "name": "fluent-emoji",
    "tags": ["type:ui"],
    "targets": {
      "lint-deps": {},
      "rclone:sync": {
        "executor": "nx:run-commands",
        "options": {
          "cwd": "{projectRoot}",
          "command": "./tools/rclone-sync.sh"
        }
      },
      "emoji-manifest": {
        "executor": "nx:run-commands",
        "outputs": [
          "{projectRoot}/src/lib/emoji-manifest.ts"
        ],
        "options": {
          "cwd": "{projectRoot}",
          "command": "node tools/build-emoji-manifest.mts"
        }
      }
    }
  }
}
