{
  "name": "@zeroxsolutions/fluent-emoji",
  "version": "0.0.1",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "NOTICE",
    "!dist/assets/anim",
    "!**/*.tsbuildinfo"
  ],
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "nx": {
    "name": "fluent-emoji",
    "targets": {
      "r2:sync": {
        "executor": "nx:run-commands",
        "options": {
          "cwd": "{projectRoot}",
          "command": "node tools/r2-sync/main.ts"
        }
      }
    }
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1115.0",
    "sharp": "^0.35.2"
  }
}
