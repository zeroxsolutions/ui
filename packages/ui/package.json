{
  "name": "@zeroxsolutions/ui",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "exports": {
    "./registry/*": {
      "types": [
        "./registry/*.tsx",
        "./registry/*.ts"
      ],
      "default": "./registry/*"
    },
    "./site/*": {
      "types": [
        "./src/site/*.tsx",
        "./src/site/*.ts"
      ],
      "default": "./src/site/*"
    },
    "./test/*": {
      "types": "./src/test/*.tsx",
      "default": "./src/test/*.tsx"
    },
    "./host": {
      "types": "./src/host/host-provider.tsx",
      "default": "./src/host/host-provider.tsx"
    },
    "./registry.json": "./registry.json",
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@base-ui/react": "catalog:",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@fontsource-variable/geist": "5.3.0",
    "@shadcn/react": "^0.3.1",
    "@shikijs/langs": "catalog:",
    "@tailwindcss/typography": "^0.5.19",
    "@tanstack/react-table": "^8.21.3",
    "@tiptap/core": "^3.33.0",
    "@tiptap/extension-details": "^3.33.0",
    "@tiptap/extension-highlight": "^3.33.0",
    "@tiptap/extension-image": "^3.33.0",
    "@tiptap/extension-link": "^3.33.0",
    "@tiptap/extension-list": "^3.33.0",
    "@tiptap/extension-mathematics": "^3.33.0",
    "@tiptap/extension-placeholder": "^3.33.0",
    "@tiptap/extension-subscript": "^3.33.0",
    "@tiptap/extension-superscript": "^3.33.0",
    "@tiptap/extension-table": "^3.33.0",
    "@tiptap/extension-task-item": "^3.33.0",
    "@tiptap/extension-task-list": "^3.33.0",
    "@tiptap/extension-text-style": "^3.33.0",
    "@tiptap/extensions": "^3.33.0",
    "@tiptap/pm": "^3.33.0",
    "@tiptap/react": "^3.33.0",
    "@tiptap/starter-kit": "^3.33.0",
    "@zeroxsolutions/editor-core": "workspace:*",
    "@zeroxsolutions/fluent-emoji": "workspace:*",
    "@zeroxsolutions/icons": "workspace:*",
    "@zeroxsolutions/routing": "catalog:",
    "class-variance-authority": "catalog:",
    "cmdk": "^1.1.1",
    "cn": "^0.5.2",
    "date-fns": "catalog:",
    "embla-carousel-react": "^8.6.0",
    "fumadocs-core": "catalog:",
    "input-otp": "^1.5.0",
    "katex": "^0.19.1",
    "lucide-react": "catalog:",
    "mermaid": "^11.16.0",
    "motion": "catalog:",
    "react-day-picker": "^10.0.2",
    "react-hook-form": "catalog:",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.18.1",
    "recharts": "3.10.1",
    "remark": "^15.0.1",
    "remark-gfm": "^4.0.1",
    "rough-notation": "^0.5.1",
    "shiki": "catalog:",
    "sonner": "^2.0.8",
    "tiptap-extension-global-drag-handle": "^0.1.18",
    "unified": "^11.0.5",
    "vaul": "^1.1.2",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@zeroxsolutions/shadcn-upstream": "workspace:*",
    "@tailwindcss/postcss": "catalog:",
    "@types/katex": "^0.16.7",
    "msw": "3.0.0",
    "shadcn": "catalog:",
    "tw-animate-css": "^1.4.0"
  },
  "peerDependencies": {
    "next-themes": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tailwindcss": "catalog:"
  },
  "nx": {
    "tags": [
      "type:ui"
    ],
    "targets": {
      "build-registry": {
        "executor": "nx:run-commands",
        "outputs": [
          "{projectRoot}/dist/r"
        ],
        "cache": true,
        "options": {
          "cwd": "{projectRoot}",
          "commands": [
            "rm -rf dist/r",
            "node tools/build-registry.mts",
            "shadcn registry validate registry.json"
          ],
          "parallel": false
        }
      },
      "sync-primitives": {
        "executor": "nx:run-commands",
        "options": {
          "cwd": "{projectRoot}",
          "command": "node tools/sync-primitives.mts"
        }
      },
      "examples-index": {
        "executor": "nx:run-commands",
        "outputs": [
          "{projectRoot}/registry/bases/base-ui/examples/__index__.tsx",
          "{projectRoot}/registry/bases/base-ui/examples/__components__.tsx"
        ],
        "cache": true,
        "options": {
          "cwd": "{projectRoot}",
          "command": "node tools/build-examples-index.mts"
        }
      },
      "test": {
        "dependsOn": [
          "^build",
          "examples-index"
        ]
      },
      "typecheck": {
        "dependsOn": [
          "^typecheck",
          "^build",
          "examples-index"
        ]
      }
    }
  }
}
