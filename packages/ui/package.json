{
  "name": "@zeroxsolutions/ui",
  "version": "0.0.1",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    "./styles.css": "./dist/styles.css",
    "./source.css": "./dist/source.css",
    "./package.json": "./package.json",
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js"
    }
  },
  "files": [
    "dist",
    "!**/*.tsbuildinfo"
  ],
  "peerDependencies": {
    "@base-ui/react": "^1.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@zeroxsolutions/fluent-emoji": "workspace:*",
    "@zeroxsolutions/icons": "workspace:*",
    "@fontsource-variable/inter": "^5.2.8",
    "@shadcn/react": "^0.1.0",
    "@shikijs/langs": "4.2.0",
    "@tanstack/react-table": "^8.21.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.4.2",
    "lucide-react": "catalog:",
    "motion": "^12.40.0",
    "next-themes": "^0.4.6",
    "react-day-picker": "^10.0.1",
    "react-hook-form": "^7.80.0",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.11.2",
    "recharts": "3.8.0",
    "remark-gfm": "^4.0.1",
    "rough-notation": "^0.5.1",
    "shiki": "^4.2.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "vaul": "^1.1.2"
  },
  "devDependencies": {
    "@base-ui/react": "^1.6.0",
    "@tailwindcss/vite": "^4.3.1",
    "glob": "^13.0.6",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "shadcn": "^4.11.0",
    "tailwindcss": "^4.3.1",
    "tw-animate-css": "^1.4.0",
    "vite-plugin-lib-inject-css": "^2.2.2"
  },
  "nx": {
    "targets": {
      "shadcn-build": {
        "executor": "nx:run-commands",
        "outputs": [
          "{workspaceRoot}/apps/registry/public/r"
        ],
        "options": {
          "cwd": "{projectRoot}",
          "command": "shadcn build -o ../../apps/registry/public/r && shadcn registry validate registry.json"
        }
      }
    }
  }
}