{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./out-tsc/vitest",
    "types": ["vitest/globals", "vitest/importMeta", "vite/client", "node", "vitest"],
    "forceConsistentCasingInFileNames": true,
    "jsx": "react-jsx",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["es2023", "dom", "dom.iterable"],
    "paths": {
      "@/registry/*": ["./registry/*"]
    }
  },
  "include": [
    "vite.config.ts",
    "vite.config.mts",
    "vitest.config.ts",
    "vitest.config.mts",
    "test/**/*.ts",
    "test/**/*.tsx",
    "registry/**/*.test.ts",
    "registry/**/*.spec.ts",
    "registry/**/*.test.tsx",
    "registry/**/*.spec.tsx",
    "registry/**/*.test.js",
    "registry/**/*.spec.js",
    "registry/**/*.test.jsx",
    "registry/**/*.spec.jsx",
    "registry/**/*.d.ts",
    "src/**/*.test.ts",
    "src/**/*.spec.ts",
    "src/**/*.test.tsx",
    "src/**/*.spec.tsx"
  ],
  "references": [
    {
      "path": "./tsconfig.lib.json"
    }
  ]
}
