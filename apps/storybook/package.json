{
  "name": "@zeroxsolutions/storybook",
  "version": "0.0.1",
  "private": true,
  "dependencies": {
    "@zeroxsolutions/editor": "workspace:*",
    "@zeroxsolutions/fluent-emoji": "workspace:*",
    "@zeroxsolutions/icons": "workspace:*",
    "@zeroxsolutions/ui": "workspace:*",
    "lucide-react": "^1.21.0",
    "sonner": "^2.0.7"
  },
  "devDependencies": {
    "@storybook/test-runner": "^0.24.4",
    "@tailwindcss/vite": "^4.3.1",
    "@tanstack/react-table": "^8.21.3",
    "react-hook-form": "^7.80.0",
    "recharts": "3.8.0",
    "tailwindcss": "^4.3.1",
    "wrangler": "catalog:"
  },
  "nx": {
    "targets": {
      "test-storybook": {
        "executor": "nx:run-commands",
        "options": {
          "cwd": "{projectRoot}",
          "command": "test-storybook -c .storybook"
        }
      },
      "deploy": {
        "executor": "nx:run-commands",
        "defaultConfiguration": "development",
        "dependsOn": [
          "build-storybook"
        ],
        "configurations": {
          "development": {
            "command": "wrangler deploy --env development"
          },
          "production": {
            "command": "wrangler deploy --env production"
          }
        },
        "options": {
          "cwd": "{projectRoot}"
        }
      },
      "upload": {
        "executor": "nx:run-commands",
        "defaultConfiguration": "development",
        "dependsOn": [
          "build-storybook"
        ],
        "configurations": {
          "development": {
            "command": "wrangler versions upload --env development"
          },
          "production": {
            "command": "wrangler versions upload --env production"
          }
        },
        "options": {
          "cwd": "{projectRoot}"
        }
      }
    }
  }
}
