{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "preserve",
    "noEmit": true,
    "emitDeclarationOnly": false,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true,
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"],
      // The items in packages/ui import each other through this alias, which this program resolves for them.
      "@/registry/*": ["../../packages/ui/registry/*"],
      // fumadocs-mdx bundles `source.config.ts` and leaves a package's import to Node, which cannot load a
      // `.ts` through the package's exports; a path this program maps is bundled with it.
      "@zeroxsolutions/ui/site/lib/rehype-docs-code": ["../../packages/ui/src/site/lib/rehype-docs-code.ts"],
      "@zeroxsolutions/native-ui-docs-web/lib/remark-native-demo-source": [
        "../../packages/native-ui-docs-web/src/lib/remark-native-demo-source.ts"
      ],
      // Written by the `fumadocs-generate` target, which `build` runs first; a `tsc` run by hand before it
      // fails with `Cannot find module 'collections/server'`.
      "collections/*": ["./.source/*"]
    },
    "outDir": "dist",
    "rootDir": ".",
    "tsBuildInfoFile": "dist/tsconfig.tsbuildinfo"
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.js",
    "src/**/*.jsx",
    "source.config.ts",
    ".source/**/*.ts",
    "../../apps/registry-native-ui-docs-zone/.next/types/**/*.ts",
    "../../dist/apps/registry-native-ui-docs-zone/.next/types/**/*.ts",
    "index.d.ts",
    "next-env.d.ts"
  ],
  "exclude": [
    "out-tsc",
    "dist",
    "node_modules",
    "jest.config.ts",
    "jest.config.cts",
    "src/**/*.spec.ts",
    "src/**/*.test.ts",
    "vite.config.ts",
    "vite.config.mts",
    "vitest.config.ts",
    "vitest.config.mts",
    "src/**/*.test.tsx",
    "src/**/*.spec.tsx",
    "src/**/*.test.js",
    "src/**/*.spec.js",
    "src/**/*.test.jsx",
    "src/**/*.spec.jsx",
    ".next"
  ],
  "references": [
    {
      "path": "../../packages/ui"
    },
    {
      "path": "../../packages/native-ui-docs-web"
    },
    {
      "path": "../../packages/fluent-emoji"
    },
    {
      "path": "../../packages/native-ui"
    }
  ]
}
