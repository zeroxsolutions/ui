{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ui-sdk-registry-native-ui-docs-zone",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-20",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // next-themes inlines its theme script from the function's own source. With the bundler's name-keeping
  // on, a page rendered in the worker carries a script calling `__name`, which the browser never
  // defines, so it throws and the theme is set only after hydration.
  "keep_names": false,
  "observability": { "enabled": true },
  // Both addresses `wrangler dev` binds, beside registry-ui's 8787 and 9229. Unset, the server port
  // silently becomes the next free one.
  "dev": { "port": 8788, "inspector_port": 9230 },
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "env": {
    "development": {
      "workers_dev": true,
    },
    "production": {
      "workers_dev": false,
      // Absent, a versioned preview still gets a *.workers.dev hostname from the account's own
      // subdomain setting; the registry has one public host.
      "preview_urls": false,
      // The native paths on registry-ui's host. Cloudflare sends a request to the most specific matching
      // route, so a path listed here is never registry-ui's.
      "routes": [
        { "pattern": "ui.zeroxsolutions.com/native", "zone_name": "zeroxsolutions.com" },
        { "pattern": "ui.zeroxsolutions.com/native/*", "zone_name": "zeroxsolutions.com" },
        { "pattern": "ui.zeroxsolutions.com/native-preview/*", "zone_name": "zeroxsolutions.com" },
        { "pattern": "ui.zeroxsolutions.com/native-preview-uniwind/*", "zone_name": "zeroxsolutions.com" },
        { "pattern": "ui.zeroxsolutions.com/og/native/*", "zone_name": "zeroxsolutions.com" },
        { "pattern": "ui.zeroxsolutions.com/llms.mdx/native/*", "zone_name": "zeroxsolutions.com" },
        { "pattern": "ui.zeroxsolutions.com/native-static/*", "zone_name": "zeroxsolutions.com" },
        { "pattern": "ui.zeroxsolutions.com/r/styles/nativewind-*", "zone_name": "zeroxsolutions.com" },
        { "pattern": "ui.zeroxsolutions.com/r/styles/uniwind-*", "zone_name": "zeroxsolutions.com" },
      ],
    },
  },
}
