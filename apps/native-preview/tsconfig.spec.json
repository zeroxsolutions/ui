{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./out-tsc/jest",
    "jsx": "react-jsx",
    "types": ["jest", "node"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["es2023", "dom"],
    // preview-style.js is CommonJS, for the Metro, Tailwind and Expo configs that require it.
    "allowJs": true,
    // As tsconfig.app.json maps them, for a spec importing a style's demos.
    "paths": {
      "@/*": ["../../packages/native-ui/dist/src/nativewind-vega/*"],
      "@styles/*": ["../../packages/native-ui/dist/src/nativewind-*"]
    }
  },
  "files": ["src/test-setup.ts", "nativewind-env.d.ts", "css.d.ts"],
  "include": [
    "jest.config.cts",
    "preview-style.js",
    "preview-style.spec.ts",
    "app-config.spec.ts",
    "src/**/*.spec.ts",
    "src/**/*.spec.tsx"
  ],
  "references": [{ "path": "./tsconfig.app.json" }]
}
