{
  "name": "@zeroxsolutions/native-preview",
  "version": "0.0.1",
  "private": true,
  "dependencies": {
    "@expo-google-fonts/geist": "catalog:",
    "@expo/metro-runtime": "catalog:expo",
    "@rn-primitives/accordion": "catalog:rn-primitives",
    "@rn-primitives/alert-dialog": "catalog:rn-primitives",
    "@rn-primitives/aspect-ratio": "catalog:rn-primitives",
    "@rn-primitives/avatar": "catalog:rn-primitives",
    "@rn-primitives/checkbox": "catalog:rn-primitives",
    "@rn-primitives/collapsible": "catalog:rn-primitives",
    "@rn-primitives/context-menu": "catalog:rn-primitives",
    "@rn-primitives/dialog": "catalog:rn-primitives",
    "@rn-primitives/dropdown-menu": "catalog:rn-primitives",
    "@rn-primitives/hover-card": "catalog:rn-primitives",
    "@rn-primitives/label": "catalog:rn-primitives",
    "@rn-primitives/menubar": "catalog:rn-primitives",
    "@rn-primitives/popover": "catalog:rn-primitives",
    "@rn-primitives/portal": "catalog:rn-primitives",
    "@rn-primitives/progress": "catalog:rn-primitives",
    "@rn-primitives/radio-group": "catalog:rn-primitives",
    "@rn-primitives/select": "catalog:rn-primitives",
    "@rn-primitives/separator": "catalog:rn-primitives",
    "@rn-primitives/slot": "catalog:rn-primitives",
    "@rn-primitives/switch": "catalog:rn-primitives",
    "@rn-primitives/table": "catalog:rn-primitives",
    "@rn-primitives/tabs": "catalog:rn-primitives",
    "@rn-primitives/toggle": "catalog:rn-primitives",
    "@rn-primitives/toggle-group": "catalog:rn-primitives",
    "@rn-primitives/tooltip": "catalog:rn-primitives",
    "@tanstack/react-table": "catalog:",
    "@zeroxsolutions/native-ui": "workspace:*",
    "class-variance-authority": "catalog:",
    "clsx": "catalog:",
    "d3-scale": "catalog:",
    "d3-shape": "catalog:",
    "date-fns": "catalog:",
    "expo": "catalog:expo",
    "expo-clipboard": "catalog:expo",
    "expo-image": "catalog:expo",
    "expo-font": "catalog:expo",
    "expo-splash-screen": "catalog:expo",
    "expo-status-bar": "catalog:expo",
    "expo-updates": "catalog:expo",
    "lucide-react-native": "catalog:",
    "nativewind": "4.2.7",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-hook-form": "catalog:",
    "react-native": "catalog:expo",
    "react-native-css-interop": "catalog:",
    "react-native-reanimated": "catalog:expo",
    "react-native-safe-area-context": "catalog:expo",
    "react-native-svg": "catalog:expo",
    "react-native-web": "catalog:expo",
    "react-native-worklets": "catalog:expo",
    "remark-gfm": "catalog:",
    "remark-parse": "catalog:",
    "shiki": "catalog:",
    "tailwind-merge": "^2.6.0",
    "unified": "catalog:"
  },
  "devDependencies": {
    "@testing-library/react-native": "catalog:",
    "@types/jest": "catalog:",
    "babel-jest": "catalog:",
    "babel-preset-expo": "catalog:expo",
    "jest": "catalog:",
    "jest-expo": "catalog:expo",
    "react-test-renderer": "catalog:",
    "tailwindcss": "^3.4.17"
  },
  "nx": {
    "targets": {
      "export": {
        "dependsOn": [
          "...",
          "^build-registry"
        ],
        "outputs": [
          "{workspaceRoot}/apps/registry-native-ui-docs-zone/public/native-preview"
        ],
        "options": {
          "args": [
            "...",
            "--platform",
            "web",
            "--output-dir",
            "../registry-native-ui-docs-zone/public/native-preview"
          ]
        }
      },
      "test": {
        "dependsOn": [
          "^build",
          "^build-registry"
        ]
      },
      "eas:update": {
        "executor": "nx:run-commands",
        "dependsOn": [
          "^build-registry"
        ],
        "options": {
          "cwd": "{projectRoot}",
          "parallel": false
        },
        "configurations": {
          "production": {
            "commands": [
              "EXPO_PUBLIC_STYLE=vega eas update --channel vega --message \"$GITHUB_SHA\" --environment preview --input-dir dist/update/vega --non-interactive",
              "EXPO_PUBLIC_STYLE=luma eas update --channel luma --message \"$GITHUB_SHA\" --environment preview --input-dir dist/update/luma --non-interactive",
              "EXPO_PUBLIC_STYLE=lyra eas update --channel lyra --message \"$GITHUB_SHA\" --environment preview --input-dir dist/update/lyra --non-interactive",
              "EXPO_PUBLIC_STYLE=maia eas update --channel maia --message \"$GITHUB_SHA\" --environment preview --input-dir dist/update/maia --non-interactive",
              "EXPO_PUBLIC_STYLE=mira eas update --channel mira --message \"$GITHUB_SHA\" --environment preview --input-dir dist/update/mira --non-interactive",
              "EXPO_PUBLIC_STYLE=nova eas update --channel nova --message \"$GITHUB_SHA\" --environment preview --input-dir dist/update/nova --non-interactive",
              "EXPO_PUBLIC_STYLE=rhea eas update --channel rhea --message \"$GITHUB_SHA\" --environment preview --input-dir dist/update/rhea --non-interactive",
              "EXPO_PUBLIC_STYLE=sera eas update --channel sera --message \"$GITHUB_SHA\" --environment preview --input-dir dist/update/sera --non-interactive"
            ]
          }
        }
      }
    },
    "tags": [
      "build:remote"
    ]
  }
}
