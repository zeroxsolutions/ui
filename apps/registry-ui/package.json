{
  "name": "@zeroxsolutions/registry-ui",
  "version": "0.0.1",
  "private": true,
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@codemirror/commands": "^6.10.3",
    "@codemirror/language": "^6.12.3",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.43.1",
    "@fontsource-variable/geist": "^5.3.0",
    "@opennextjs/cloudflare": "1.20.7",
    "@shadcn/react": "^0.1.0",
    "@shikijs/langs": "4.2.0",
    "@tailwindcss/typography": "^0.5.19",
    "@tanstack/react-table": "^8.21.3",
    "@tiptap/core": "^3.27.3",
    "@tiptap/extension-details": "^3.27.3",
    "@tiptap/extension-highlight": "^3.27.3",
    "@tiptap/extension-image": "^3.27.3",
    "@tiptap/extension-link": "^3.27.3",
    "@tiptap/extension-list": "^3.27.3",
    "@tiptap/extension-mathematics": "^3.27.3",
    "@tiptap/extension-placeholder": "^3.27.3",
    "@tiptap/extension-subscript": "^3.27.3",
    "@tiptap/extension-superscript": "^3.27.3",
    "@tiptap/extension-table": "^3.27.3",
    "@tiptap/extension-task-item": "^3.27.3",
    "@tiptap/extension-task-list": "^3.27.3",
    "@tiptap/extension-text-style": "^3.27.3",
    "@tiptap/extensions": "^3.27.3",
    "@tiptap/pm": "^3.27.3",
    "@tiptap/react": "^3.27.3",
    "@tiptap/starter-kit": "^3.27.3",
    "@zeroxsolutions/editor-core": "workspace:*",
    "@zeroxsolutions/fluent-emoji": "workspace:*",
    "@zeroxsolutions/icons": "workspace:*",
    "@zeroxsolutions/routing": "0.0.7",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.4.0",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "fumadocs-core": "16.15.17",
    "fumadocs-mdx": "15.4.5",
    "input-otp": "^1.4.2",
    "katex": "^0.16.11",
    "lucide-react": "catalog:",
    "mermaid": "^11.16.0",
    "motion": "^12.40.0",
    "next": "catalog:",
    "next-themes": "^0.4.6",
    "react": "^19.2.7",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.7",
    "react-hook-form": "^7.80.0",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.11.2",
    "recharts": "3.8.0",
    "remark": "^15.0.1",
    "remark-gfm": "^4.0.1",
    "rough-notation": "^0.5.1",
    "shiki": "^4.2.0",
    "sonner": "^2.0.7",
    "tiptap-extension-global-drag-handle": "^0.1.18",
    "unified": "^11.0.5",
    "vaul": "^1.1.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.1",
    "@types/katex": "^0.16.7",
    "msw": "3.0.0",
    "shadcn": "^4.21.0",
    "tailwindcss": "^4.3.1",
    "tw-animate-css": "^1.4.0",
    "wrangler": "catalog:"
  },
  "nx": {
    "targets": {
      "test": {
        "dependsOn": [
          "^build",
          "fumadocs-generate",
          "examples-index"
        ]
      },
      "build": {
        "dependsOn": [
          "^build",
          "shadcn-build",
          "fumadocs-generate",
          "examples-index"
        ]
      },
      "wrangler:build": {
        "executor": "nx:run-commands",
        "dependsOn": [
          "^build",
          "shadcn-build",
          "fumadocs-generate",
          "examples-index"
        ],
        "outputs": [
          "{projectRoot}/.open-next"
        ],
        "cache": true,
        "options": {
          "cwd": "{projectRoot}",
          "command": "rm -rf .open-next && next build && opennextjs-cloudflare build --skipNextBuild"
        }
      },
      "wrangler:dev": {
        "executor": "nx:run-commands",
        "dependsOn": [
          "wrangler:build"
        ],
        "continuous": true,
        "options": {
          "cwd": "{projectRoot}",
          "command": "opennextjs-cloudflare preview --env development"
        }
      },
      "wrangler:typegen": {
        "executor": "nx:run-commands",
        "options": {
          "cwd": "{projectRoot}",
          "command": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
        }
      },
      "shadcn-build": {
        "executor": "nx:run-commands",
        "outputs": [
          "{workspaceRoot}/apps/registry-ui/public/r"
        ],
        "options": {
          "cwd": "{projectRoot}",
          "commands": [
            "rm -rf public/r",
            "shadcn build -o public/r",
            "shadcn registry validate registry.json"
          ],
          "parallel": false
        }
      },
      "fumadocs-generate": {
        "executor": "nx:run-commands",
        "outputs": [
          "{projectRoot}/.source"
        ],
        "cache": true,
        "options": {
          "cwd": "{projectRoot}",
          "command": "fumadocs-mdx"
        }
      },
      "examples-index": {
        "executor": "nx:run-commands",
        "outputs": [
          "{projectRoot}/registry/bases/base-ui/examples/__index__.tsx",
          "{projectRoot}/registry/bases/base-ui/examples/__components__.tsx"
        ],
        "cache": true,
        "options": {
          "cwd": "{projectRoot}",
          "command": "node tools/build-examples-index.mts"
        }
      }
    }
  }
}
