  },
  "nx": {
    "targets": {
      "shadcn-build": {
        "executor": "nx:run-commands",
        "outputs": [
          "{workspaceRoot}/apps/registry-ui/public/r"
        ],
        "options": {
          "cwd": "{projectRoot}",
          "commands": [
            "rm -rf public/r",
            "shadcn build -o public/r",
            "shadcn registry validate registry.json"
          ],
          "parallel": false
        }
      }
    }
  }
