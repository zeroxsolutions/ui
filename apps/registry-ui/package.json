{
  "name": "@zeroxsolutions/registry-ui",
  "version": "0.0.1",
  "private": true,
  "dependencies": {
    "@base-ui/react": "catalog:",
    "@opennextjs/cloudflare": "1.20.7",
    "@shikijs/langs": "catalog:",
    "@zeroxsolutions/fluent-emoji": "workspace:*",
    "@zeroxsolutions/native-ui-docs-web": "workspace:*",
    "@zeroxsolutions/routing": "catalog:",
    "@zeroxsolutions/ui": "workspace:*",
    "@zeroxsolutions/ui-docs-web": "workspace:*",
    "fumadocs-core": "catalog:",
    "fumadocs-mdx": "15.4.5",
    "lucide-react": "catalog:",
    "next": "catalog:",
    "next-themes": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "shiki": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "catalog:",
    "@zeroxsolutions/native-ui": "workspace:*",
    "tailwindcss": "catalog:",
    "wrangler": "catalog:"
  },
  "nx": {
    "targets": {
      "dev": {
        "dependsOn": [
          "^build",
          "shadcn-build",
          "@zeroxsolutions/native-preview:export",
          "@zeroxsolutions/native-preview-uniwind:export",
          "fumadocs-generate",
          "@zeroxsolutions/ui:examples-index"
        ]
      },
      "test": {
        "dependsOn": [
          "^build",
          "fumadocs-generate",
          "@zeroxsolutions/ui:examples-index"
        ]
      },
      "build": {
        "dependsOn": [
          "^build",
          "^typecheck",
          "shadcn-build",
          "@zeroxsolutions/native-preview:export",
          "@zeroxsolutions/native-preview-uniwind:export",
          "fumadocs-generate",
          "@zeroxsolutions/ui:examples-index"
        ]
      },
      "wrangler:build": {
        "executor": "nx:run-commands",
        "dependsOn": [
          "^build",
          "^typecheck",
          "shadcn-build",
          "@zeroxsolutions/native-preview:export",
          "@zeroxsolutions/native-preview-uniwind:export",
          "fumadocs-generate",
          "@zeroxsolutions/ui:examples-index"
        ],
        "inputs": [
          "default",
          "^default",
          {
            "runtime": "pwd"
          }
        ],
        "outputs": [
          "{projectRoot}/.open-next"
        ],
        "cache": true,
        "options": {
          "cwd": "{projectRoot}",
          "command": "rm -rf .open-next && next build && opennextjs-cloudflare build --skipNextBuild"
        }
      },
      "wrangler:dev": {
        "executor": "nx:run-commands",
        "dependsOn": [
          "wrangler:build"
        ],
        "continuous": true,
        "options": {
          "cwd": "{projectRoot}",
          "command": "opennextjs-cloudflare preview --env development"
        }
      },
      "wrangler:deploy": {
        "executor": "nx:run-commands",
        "dependsOn": [
          "wrangler:build"
        ],
        "options": {
          "cwd": "{projectRoot}"
        },
        "configurations": {
          "production": {
            "command": "opennextjs-cloudflare deploy --env production"
          }
        }
      },
      "wrangler:typegen": {
        "executor": "nx:run-commands",
        "options": {
          "cwd": "{projectRoot}",
          "command": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
        }
      },
      "shadcn-build": {
        "executor": "nx:run-commands",
        "dependsOn": [
          "@zeroxsolutions/ui:build-registry",
          "@zeroxsolutions/native-ui:build-registry"
        ],
        "outputs": [
          "{workspaceRoot}/apps/registry-ui/public/r"
        ],
        "options": {
          "cwd": "{projectRoot}",
          "commands": [
            "rm -rf public/r",
            "mkdir -p public/r/styles",
            "cp -R ../../packages/ui/dist/r/styles/. public/r/styles/",
            "cp -R ../../packages/native-ui/dist/r/styles/. public/r/styles/"
          ],
          "parallel": false
        }
      },
      "fumadocs-generate": {
        "executor": "nx:run-commands",
        "dependsOn": [
          "@zeroxsolutions/ui:examples-index"
        ],
        "outputs": [
          "{projectRoot}/.source"
        ],
        "cache": true,
        "options": {
          "cwd": "{projectRoot}",
          "command": "fumadocs-mdx"
        }
      }
    }
  }
}
