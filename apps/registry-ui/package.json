{
  "name": "@zeroxsolutions/registry-ui",
  "version": "0.0.1",
  "private": true,
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@fontsource-variable/geist": "5.3.0",
    "@opennextjs/cloudflare": "1.20.13",
    "@shadcn/react": "^0.3.1",
    "@shikijs/langs": "4.5.0",
    "@tailwindcss/typography": "^0.5.19",
    "@tanstack/react-table": "^8.21.3",
    "@tiptap/core": "^3.32.0",
    "@tiptap/extension-details": "^3.32.0",
    "@tiptap/extension-highlight": "^3.32.0",
    "@tiptap/extension-image": "^3.32.0",
    "@tiptap/extension-link": "^3.32.0",
    "@tiptap/extension-list": "^3.32.0",
    "@tiptap/extension-mathematics": "^3.32.0",
    "@tiptap/extension-placeholder": "^3.32.0",
    "@tiptap/extension-subscript": "^3.32.0",
    "@tiptap/extension-superscript": "^3.32.0",
    "@tiptap/extension-table": "^3.32.0",
    "@tiptap/extension-task-item": "^3.32.0",
    "@tiptap/extension-task-list": "^3.32.0",
    "@tiptap/extension-text-style": "^3.32.0",
    "@tiptap/extensions": "^3.32.0",
    "@tiptap/pm": "^3.32.0",
    "@tiptap/react": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "@zeroxsolutions/editor-core": "workspace:*",
    "@zeroxsolutions/fluent-emoji": "workspace:*",
    "@zeroxsolutions/icons": "workspace:*",
    "@zeroxsolutions/routing": "0.0.12",
    "class-variance-authority": "catalog:",
    "cmdk": "^1.1.1",
    "cn": "^0.5.0",
    "date-fns": "catalog:",
    "embla-carousel-react": "^8.6.0",
    "fumadocs-core": "16.17.7",
    "fumadocs-mdx": "15.4.9",
    "input-otp": "^1.5.0",
    "katex": "^0.19.0",
    "lucide-react": "catalog:",
    "mermaid": "^11.16.0",
    "motion": "^12.40.0",
    "next": "catalog:",
    "next-themes": "^0.4.6",
    "qrcode.react": "^4.2.0",
    "react": "catalog:",
    "react-day-picker": "^10.0.2",
    "react-dom": "catalog:",
    "react-hook-form": "catalog:",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.14.8",
    "recharts": "3.10.1",
    "remark": "^15.0.1",
    "remark-gfm": "^4.0.1",
    "rough-notation": "^0.5.1",
    "shiki": "catalog:",
    "sonner": "^2.0.8",
    "tiptap-extension-global-drag-handle": "^0.1.18",
    "unified": "^11.0.5",
    "vaul": "^1.1.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.1",
    "@types/katex": "^0.16.7",
    "@zeroxsolutions/native-ui": "workspace:*",
    "msw": "3.0.0",
    "shadcn": "catalog:",
    "tailwindcss": "catalog:",
    "tw-animate-css": "^1.4.0",
    "wrangler": "catalog:"
  },
  "nx": {
    "targets": {
      "dev": {
        "dependsOn": [
          "^build",
          "shadcn-build",
          "@zeroxsolutions/native-preview:export",
          "@zeroxsolutions/native-preview-uniwind:export",
          "fumadocs-generate",
          "examples-index"
        ]
      },
      "test": {
        "dependsOn": [
          "^build",
          "fumadocs-generate",
          "examples-index"
        ]
      },
      "build": {
        "dependsOn": [
          "^build",
          "shadcn-build",
          "@zeroxsolutions/native-preview:export",
          "@zeroxsolutions/native-preview-uniwind:export",
          "fumadocs-generate",
          "examples-index"
        ]
      },
      "wrangler:build": {
        "executor": "nx:run-commands",
        "dependsOn": [
          "^build",
          "shadcn-build",
          "@zeroxsolutions/native-preview:export",
          "@zeroxsolutions/native-preview-uniwind:export",
          "fumadocs-generate",
          "examples-index"
        ],
        "inputs": [
          "default",
          "^default",
          {
            "runtime": "pwd"
          }
        ],
        "outputs": [
          "{projectRoot}/.open-next"
        ],
        "cache": true,
        "options": {
          "cwd": "{projectRoot}",
          "command": "rm -rf .open-next && next build && opennextjs-cloudflare build --skipNextBuild"
        }
      },
      "wrangler:dev": {
        "executor": "nx:run-commands",
        "dependsOn": [
          "wrangler:build"
        ],
        "continuous": true,
        "options": {
          "cwd": "{projectRoot}",
          "command": "opennextjs-cloudflare preview --env development"
        }
      },
      "wrangler:deploy": {
        "executor": "nx:run-commands",
        "dependsOn": [
          "wrangler:build"
        ],
        "options": {
          "cwd": "{projectRoot}"
        },
        "configurations": {
          "production": {
            "command": "opennextjs-cloudflare deploy --env production"
          }
        }
      },
      "wrangler:typegen": {
        "executor": "nx:run-commands",
        "options": {
          "cwd": "{projectRoot}",
          "command": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
        }
      },
      "shadcn-build": {
        "executor": "nx:run-commands",
        "dependsOn": [
          "@zeroxsolutions/native-ui:build-registry"
        ],
        "outputs": [
          "{workspaceRoot}/apps/registry-ui/public/r"
        ],
        "options": {
          "cwd": "{projectRoot}",
          "commands": [
            "rm -rf public/r",
            "shadcn build -o public/r/styles/base-nova",
            "for style in vega maia lyra mira luma sera rhea; do cp -R public/r/styles/base-nova public/r/styles/base-$style; done",
            "cp -R ../../packages/native-ui/dist/r/styles/. public/r/styles/",
            "shadcn registry validate registry.json"
          ],
          "parallel": false
        }
      },
      "fumadocs-generate": {
        "executor": "nx:run-commands",
        "dependsOn": [
          "examples-index"
        ],
        "outputs": [
          "{projectRoot}/.source"
        ],
        "cache": true,
        "options": {
          "cwd": "{projectRoot}",
          "command": "fumadocs-mdx"
        }
      },
      "examples-index": {
        "executor": "nx:run-commands",
        "outputs": [
          "{projectRoot}/registry/bases/base-ui/examples/__index__.tsx",
          "{projectRoot}/registry/bases/base-ui/examples/__components__.tsx"
        ],
        "cache": true,
        "options": {
          "cwd": "{projectRoot}",
          "command": "node tools/build-examples-index.mts"
        }
      }
    }
  }
}
