          "color-success": "var(--success)",
          "color-warning": "var(--warning)"
        },
        "light": {
          "success": "oklch(0.627 0.19 149)",
          "warning": "oklch(0.681 0.162 75.834)"
        },
        "dark": {
          "success": "oklch(0.723 0.19 149)",
          "warning": "oklch(0.79 0.155 80)"
        }
