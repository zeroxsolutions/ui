  "items": [
    {
      "name": "status-dot",
      "type": "registry:component",
      "categories": ["data-display"],
      "title": "Status Dot",
      "description": "A small tone-coded presence dot (online, offline, busy, idle). Exports the `StatusTone` union that other items reuse for their own status surfaces.",
      "registryDependencies": ["@shadcn/utils"],
      "files": [
        {
          "path": "registry/bases/base-ui/components/feedback/status-indicator.tsx",
          "type": "registry:component"
        }
      ]
    },
    {
      "name": "tree-item",
      "type": "registry:component",
      "categories": ["data-display"],
      "title": "Tree Item",
      "description": "One row of a hierarchy tree, including TreeItemIndent. Owns the clickable name region, inline-rename, trailing actions, and an optional context menu.",
      "dependencies": ["lucide-react"],
      "registryDependencies": ["@shadcn/button", "@shadcn/input", "@shadcn/item", "@shadcn/utils"],
      "files": [
        {
          "path": "registry/bases/base-ui/components/data-entry/tree-item.tsx",
          "type": "registry:component"
        },
        {
          "path": "registry/bases/base-ui/lib/ime.ts",
          "type": "registry:lib"
        }
      ]
    },
    {
      "name": "field-grid",
      "type": "registry:component",
      "categories": ["layout"],
      "title": "Field Grid",
      "description": "The bare label/control grid that property rows are built on - column template and gutters only, no action slot.",
      "registryDependencies": ["@shadcn/utils"],
      "files": [
        {
          "path": "registry/bases/base-ui/components/layout/panel-field-group.tsx",
          "type": "registry:component"
        }
      ]
    },
    {
      "name": "field-group",
      "type": "registry:component",
      "categories": ["layout"],
      "title": "Field Group",
      "description": "A field grid plus a fixed trailing action slot. Use it for any property row that mixes inputs with a side action - the slot is always reserved at one icon-button width so every row shares the same right edge.",
      "registryDependencies": ["https://ui.zeroxsolutions.com/r/field-grid.json", "@shadcn/utils"],
      "files": [
        {
          "path": "registry/bases/base-ui/components/layout/panel-row.tsx",
          "type": "registry:component"
        }
      ]
    },
    {
      "name": "model-info-card",
      "type": "registry:component",
