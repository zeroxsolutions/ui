# Service-account creds (Firebase admin / GCP) — secrets, never commit
creds/

# Local .terraform directories
.terraform/

# .tfstate files — contain secret values and resource ids; use the remote backend
*.tfstate
*.tfstate.*
.terraform.tfstate.lock.info

# Saved plan files — contain sensitive values (connection URIs, keys) in plaintext
*.tfplan

# Real variable files — contain API tokens / keys. Commit only *.example.
*.tfvars
*.tfvars.json

# Backend config — contains R2 access/secret keys. Commit only *.example.
*backend.config

# Override files (local-only resource overrides)
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# CLI config
.terraformrc
terraform.rc

# Crash / log files
crash.log
crash.*.log
*.log
logs/

# Editor / OS noise
*~
*.swp
.DS_Store
Thumbs.db
