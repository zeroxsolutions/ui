## Common
project_name = "classify"

## Neon PostgreSQL
neon_api_key = "<neon_api_key>"
neon_org_id  = "<neon_org_id>"
neon_databases = {
  app = "classify"
}

## Cloudflare
cloudflare_account_id = "<account_id>"
cloudflare_api_token  = "<api_token>"

# `recordings` backs the online-rooms recording seam; `grading` feeds the grading-queue worker.
cloudflare_r2_buckets    = ["files", "recordings"]
cloudflare_queues        = ["grading"]
cloudflare_kv_namespaces = []
cloudflare_d1_databases  = []
# Cloudflare Pages - connect a Git repo; Cloudflare builds+deploys on push (Pages
# Functions = a Worker; no GitHub Actions). Authorize the GitHub/GitLab app once first.
# cloudflare_pages_projects = {
#   web = {
#     production_branch = "main"
#     source     = { type = "github", config = { owner = "ZeroXSolutions", repo_name = "classify-web" } }
#     build_config = { build_command = "pnpm nx build @scope/web", root_dir = "apps/web" }
#     custom_domains = ["classify.com"]
#   }
# }
# Cloudflare Realtime SFU app id/secret feed the api-gateway (var + wrangler secret); provision
# the SFU app via Terraform/Cloudflare and keep the secret out of committed vars.

# DNS records (zone for classify's domain). content "192.0.2.1" is a placeholder
# proxied A record (orange-cloud) — the Worker route does the real routing.
cloudflare_dns_records = [
  {
    zone_id = "<zone_id>"
    type    = "A"
    name    = "<app_domain>"
    content = "192.0.2.1"
    comment = "web-app Worker"
  },
  {
    zone_id = "<zone_id>"
    type    = "A"
    name    = "api.<app_domain>"
    content = "192.0.2.1"
    comment = "api-gateway Worker"
  },
]

## Google / Firebase — Main app (end-user / web-app auth)
gcp_region                     = "asia-southeast1"
gcp_main_project_id            = "classify"
gcp_main_credentials_file_path = "./creds/classify-production.json"

## Google / Firebase — Admin app (back-office auth)
gcp_admin_project_id            = "classify-admin"
gcp_admin_credentials_file_path = "./creds/classify-admin-production.json"

## Clerk - opt-in ALTERNATIVE auth provider to Firebase (pick ONE).
