## Common
project_name = "classify"

## Neon PostgreSQL
# classify is microservices: one Neon database per bounded-context service (database-per-service).
# statistics is a read-model (no own DB — reads billing/academics); it is NOT listed here.
# Map is logical_key => postgres_database_name; each key gets its own owner role
# and a matching Hyperdrive config (see main.tf).
neon_api_key = "<neon_api_key>"
neon_org_id  = "<neon_org_id>"
neon_databases = {
  iam         = "iam"
  academics   = "academics"
  rooms       = "rooms"
  "exam-prep" = "exam_prep"
  billing     = "billing"
}

## Cloudflare
cloudflare_account_id = "<account_id>"
cloudflare_api_token  = "<api_token>"

# R2 object storage — logical names, prefixed with project+workspace at creation.
# `recordings` backs the online-rooms recording seam (RECORDINGS_BUCKET binding).
cloudflare_r2_buckets = ["files", "recordings"]

# Workers Queues — `grading` is consumed by the grading-queue worker (exam essay/report jobs).
cloudflare_queues = ["grading"]

# Cloudflare Realtime SFU — the app id/secret feed the api-gateway (REALTIME_APP_ID var +
# REALTIME_APP_SECRET wrangler secret). Provision the SFU app via Terraform/Cloudflare and wire
# its outputs; the secret never lives in committed vars.

# Workers KV — none yet.
cloudflare_kv_namespaces = []

# D1 — classify is Postgres-only (Neon via Hyperdrive), so no D1 databases.
cloudflare_d1_databases = []

# Cloudflare Pages - connect a Git repo and Cloudflare builds+deploys on push (Pages
# Functions = a Worker; no GitHub Actions). Authorize the GitHub/GitLab app on the
# account once first. Empty by default; uncomment to wire a project.
# cloudflare_pages_projects = {
#   web = {
#     production_branch = "main"
#     source = {
#       type   = "github"
#       config = { owner = "ZeroXSolutions", repo_name = "classify-web", deployments_enabled = true }
#     }
#     build_config = { build_command = "pnpm nx build @scope/web", root_dir = "apps/web" }
#     deployment_configs = {
#       production = {
#         compatibility_date = "2026-07-01"
#         env_vars           = { API_URL = { type = "plain_text", value = "https://api.classify.example" } }
#       }
#     }
#     custom_domains = ["classify.example"]
#   }
# }

## Google / Firebase — Main app (end-user / web-app auth)
gcp_region                     = "asia-southeast1"
gcp_main_project_id            = "classify-development"
gcp_main_credentials_file_path = "./creds/classify-development.json"

## Google / Firebase — Admin app (back-office auth)
gcp_admin_project_id            = "classify-admin-development"
gcp_admin_credentials_file_path = "./creds/classify-admin-development.json"

