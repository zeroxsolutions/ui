{
  "singleQuote": true,
  "trailingComma": "all",
  "arrowParens": "always",
  "bracketSpacing": true,
  "bracketSameLine": false,
  "printWidth": 120,
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "plugins": ["prettier-plugin-tailwindcss"],
  "overrides": [
    {
      "files": ["apps/*/src/components/**", "apps/*/src/hooks/**", "apps/*/src/lib/**"],
      "options": {
        "semi": false,
        "singleQuote": false,
        "printWidth": 80,
        "trailingComma": "es5"
      }
    }
  ]
}
